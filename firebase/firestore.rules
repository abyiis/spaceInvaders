rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Perfil propio.
    match /users/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }

    // Ranking: lectura para autenticados; solo se pueden crear entradas propias.
    match /leaderboard/{docId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.score is int
        && request.resource.data.score >= 0
        && request.resource.data.score <= 1000000
        && request.resource.data.mode in ['solo', 'coop']
        && (request.resource.data.mode == 'solo'
          || (request.resource.data.players is list
            && request.resource.data.players.size() >= 2
            && request.resource.data.players.size() <= 4
            && request.auth.uid in request.resource.data.players));
      allow update, delete: if false;
    }
  }
}
