{
  "rules": {
    ".read": false,
    ".write": false,
    "rooms": {
      "$roomId": {
        ".read": "auth != null",

        "meta": {
          ".write": "auth != null && (!data.exists() || data.child('hostUid').val() === auth.uid || (root.child('rooms').child($roomId).child('players').child(data.child('hostUid').val()).child('connected').val() === false && root.child('rooms').child($roomId).child('players').child(auth.uid).exists() && newData.child('hostUid').val() === auth.uid && newData.child('seed').val() === data.child('seed').val()))",
          ".validate": "newData.hasChildren(['hostUid', 'seed', 'status', 'createdAt'])",
          "hostUid": { ".validate": "newData.isString()" },
          "seed": { ".validate": "newData.isNumber()" },
          "status": {
            ".validate": "newData.val() === 'lobby' || newData.val() === 'playing' || newData.val() === 'finished'"
          },
          "createdAt": { ".validate": "newData.isNumber()" },
          "startAt": { ".validate": "newData.isNumber()" },
          "maxPlayers": { ".validate": "newData.isNumber() && newData.val() >= 1 && newData.val() <= 4" },
          "$other": { ".validate": false }
        },

        "players": {
          "$uid": {
            ".write": "auth != null && auth.uid === $uid",
            "name": { ".validate": "newData.isString() && newData.val().length <= 16" },
            "x": { ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 1" },
            "ts": { ".validate": "newData.isNumber()" },
            "ready": { ".validate": "newData.isBoolean()" },
            "connected": { ".validate": "newData.isBoolean()" },
            "$other": { ".validate": false }
          }
        },

        "state": {
          ".write": "auth != null && root.child('rooms').child($roomId).child('meta/hostUid').val() === auth.uid",
          "wave": { ".validate": "newData.isNumber() && newData.val() >= 0" },
          "score": { ".validate": "newData.isNumber() && newData.val() >= 0" },
          "status": {
            ".validate": "newData.val() === 'lobby' || newData.val() === 'playing' || newData.val() === 'finished'"
          },
          "lives": {
            "$uid": { ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 3" }
          },
          "killed": {
            "$wave": {
              "$enemyId": { ".validate": "newData.val() === true" }
            }
          },
          "$other": { ".validate": false }
        },

        "events": {
          "$eventId": {
            ".write": "auth != null && !data.exists() && newData.child('uid').val() === auth.uid",
            ".validate": "newData.hasChildren(['type', 'uid', 't']) && ((newData.child('type').val() !== 'state' && newData.child('type').val() !== 'phase' && newData.child('type').val() !== 'game-over' && newData.child('type').val() !== 'enemy-shot') || root.child('rooms').child($roomId).child('meta/hostUid').val() === newData.child('uid').val())",
            "type": {
              ".validate": "newData.val() === 'shot' || newData.val() === 'enemy-shot' || newData.val() === 'kill' || newData.val() === 'hit' || newData.val() === 'revive' || newData.val() === 'life-loss' || newData.val() === 'bonus-kill' || newData.val() === 'state' || newData.val() === 'phase' || newData.val() === 'game-over'"
            },
            "uid": { ".validate": "newData.isString()" },
            "t": { ".validate": "newData.isNumber()" },
            "x": { ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 1" },
            "y": { ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 1" },
            "wave": { ".validate": "newData.isNumber()" },
            "enemyId": { ".validate": "newData.isNumber()" },
            "targetUid": { ".validate": "newData.isString()" },
            "powerUpType": { ".validate": "newData.isString()" },
            "consumedLife": { ".validate": "newData.isBoolean()" },
            "kind": { ".validate": "newData.val() === 'wave' || newData.val() === 'boss' || newData.val() === 'bonus'" },
            "bossDefeated": { ".validate": "newData.isBoolean()" },
            "kills": { "$uid": { ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 100000" } },
            "score": { ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 1000000" },
            "lives": { ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 99" },
            "damage": { ".validate": "newData.isNumber() && newData.val() >= 1 && newData.val() <= 3" },
            "vx": { ".validate": "newData.isNumber() && newData.val() >= -200 && newData.val() <= 200" },
            "vy": { ".validate": "newData.isNumber() && newData.val() >= -500 && newData.val() <= 500" },
            "color": { ".validate": "newData.isString() && newData.val().length <= 16" },
            "shipId": { ".validate": "newData.isNumber() && newData.val() >= 0" },
            "multiplier": { ".validate": "newData.isNumber() && newData.val() >= 1 && newData.val() <= 5" },
            "$other": { ".validate": false }
          }
        }
      }
    }
  }
}
