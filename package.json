{
  "name": "space-coop",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Space Invaders arcade infinito con cooperativo en tiempo real (Canvas + JS + CSS + Capacitor + Firebase).",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "node --test",
    "assets": "node scripts/generateAssets.mjs",
    "bench": "node scripts/benchSimulation.mjs",
    "test:rules": "firebase emulators:exec --project demo-space-coop --only database,firestore \"node --test test/firebaseRules.test.js\"",
    "cap:sync": "npm run build && npx cap sync",
    "android": "npm run cap:sync && npx cap open android"
  },
  "dependencies": {
    "@capacitor/android": "^7.0.0",
    "@capacitor/app": "^7.0.0",
    "@capacitor/core": "^7.0.0",
    "@capacitor/haptics": "^7.0.0",
    "@capacitor/ios": "^7.0.0",
    "@capacitor/screen-orientation": "^7.0.4",
    "@capacitor/splash-screen": "^7.0.5",
    "firebase": "^11.0.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^7.0.0",
    "@firebase/rules-unit-testing": "^4.0.1",
    "vite": "^6.0.0"
  },
  "engines": {
    "node": ">=20"
  },
  "overrides": {
    "@grpc/grpc-js": "1.14.5"
  }
}
